# 将本文件复制为 .env，在本地填写两个服务的 Key；不要提交真实密钥。
# 在线问答固定使用 hybrid 检索 + DeepSeek，不提供离线问答模式。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_TOKENS=3000
DEEPSEEK_MAX_RETRIES=1

# 相对路径以本项目根目录为基准；下列数据与检索参数由服务端管理。
LAW_DATA_PATH=data/processed/legal_chunks.jsonl
RETRIEVAL_TOP_K=5
# 两路各自召回的父法条数，与最终 RETRIEVAL_TOP_K 不同。
HYBRID_CANDIDATE_K=50
HYBRID_RRF_K=60

# 在线向量模型；与 DeepSeek 使用独立的 Key，填真实值时只编辑本地 .env。
DASHSCOPE_API_KEY=
# 默认北京地域；Key 必须与地域匹配。使用 DashScope 原生 API，不填 compatible-mode。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
EMBEDDING_MODEL=text-embedding-v4
# 百炼 v4 支持 64/128/256/512/768/1024/1536/2048；此值同时用于请求和校验。
EMBEDDING_DIMENSIONS=2048
# v4 每次请求最多 10 条文本。
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
CHROMA_PATH=data/local/chroma
CHROMA_COLLECTION=transport_law_bailian_v4_2048_v1
# 首次使用前执行 index-vectors，并用 vector-status 检查索引。
# 问答不自动降级为 BM25；算法比较使用维护命令 evaluate --backend。
